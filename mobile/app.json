{
  "expo": {
    "name": "Karaoke Coach",
    "slug": "karaoke-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0b1020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.karaokecoach",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "歌声を録音してAIコーチにアドバイスをもらうためにマイクを使用します。"
      }
    },
    "android": {
      "package": "com.example.karaokecoach",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "歌声を録音してAIコーチにアドバイスをもらうためにマイクを使用します。"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
